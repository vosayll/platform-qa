# Скопируй в .env и заполни реальными значениями
# Логин/пароль директора (админа) тестируемого бэкенда
ADMIN_LOGIN=admin
ADMIN_PASSWORD=change-me

# Адрес тестируемого бэкенда (пусто = встроенный мок)
# BASE_URL=

# Универсальный код верификации клиента (если стенд его поддерживает)
# VERIFICATION_CODE=1234

# Каталог персистентных данных (стенды, токены, сценарии)
# DATA_DIR=/app/data

# Готовые токены ролей (обходят регистрацию/SMS)
# CLIENT_TOKEN=
# REST_TOKEN=
# COURIER_TOKEN=
# ADMIN_TOKEN=
